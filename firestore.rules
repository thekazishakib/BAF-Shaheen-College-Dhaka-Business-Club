rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && (
               request.auth.token.email == 'admin1@gmail.com'
            || request.auth.token.email == 'admin2@gmail.com'
          );
    }

    match /adminVerify/{doc} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /certificates/{certId} {
      allow read:   if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['downloaded'])
          && resource.data.email == request.auth.token.email
        );
    }

    match /heroImages/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /sponsors/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /incharges/{doc}    { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{doc}         { allow read: if true; allow write: if isAdmin(); }
    match /events/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /team/{doc}         { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /blogs/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /singleton/{doc}    { allow read: if true; allow write: if isAdmin(); }
  }
}
