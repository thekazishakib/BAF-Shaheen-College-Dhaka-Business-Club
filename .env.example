# ─────────────────────────────────────────────────────────────────────────────
# .env.example — BAFSDBC Environment Variable Template
#
# ✅ COMMIT THIS FILE  (it contains no real secrets — only placeholders)
# ❌ NEVER COMMIT .env or .env.local (add to .gitignore)
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in the values below.
#   For Vercel deployment: configure these in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Client-side configuration (prefixed with VITE_ to expose to the frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_WEB3FORMS_API_KEY=

# Server-only certificate integration
# Configure these in Vercel Environment Variables.
# Never expose these using the VITE_ prefix.

CERTIFICATE_APPS_SCRIPT_URL=
CERTIFICATE_SHARED_SECRET=
CERTIFICATE_ALLOWED_ORIGIN=
